<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ShopEase" parent="Theme.AppCompat.Light.NoActionBar" />

    <!-- Your main app theme --><style name="Theme.MyApplication" parent="Theme.AppCompat.Light.NoActionBar" />

    <!-- The Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background color of the splash screen -->
        <item name="windowSplashScreenBackground">#FFFFFF</item>

        <!-- The icon in the center (your app logo) -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <!-- What theme to switch to after the splash screen is done -->
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>
</resources>